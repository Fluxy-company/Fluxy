# Modelo do secret IEFC_APP_ENV (GitHub > Settings > Secrets and variables > Actions).
# Cole o bloco inteiro, com valores de LABORATÓRIO. O Terraform grava estes valores no
# AWS Secrets Manager (iefc/app-env) e as EC2 privadas os carregam em /opt/iefc/.env no boot.
# DOCKER_NAMESPACE e FRONTEND_BASE_URL são preenchidos automaticamente pelo Terraform.
# Hosts e portas internos (IEFC_DATABASE_HOST, REDIS_HOST, RABBITMQ_HOST...) são fixados no
# Compose da AWS e podem ficar aqui sem efeito. Linhas começando com # são ignoradas.

# Obrigatórias
IEFC_DATABASE_NAME=iefc_db
IEFC_DATABASE_USERNAME=
IEFC_DATABASE_PASSWORD=
EMAIL_DATABASE_NAME=email_db
EMAIL_DATABASE_USERNAME=
EMAIL_DATABASE_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASS=
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=
APP_ADMIN_EMAIL=
APP_ADMIN_SENHA=

# Opcionais
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
APP_USUARIO_PADRAO_EMAIL=
APP_USUARIO_PADRAO_SENHA=
EMAIL_SERVICE_API_KEY=
EMAIL_SERVICE_BASE_URL=http://email-service:8080
EMAIL_SERVICE_REMETENTE=no-reply@iefc.org.br
ADMIN_NOTIFICACAO_EMAIL=admin@iefc.org.br
EMAIL_REMETENTE_PADRAO=no-reply@iefc.org.br
EMAIL_MAX_TENTATIVAS=5
RELATORIO_EMAIL_DESTINATARIO=admin@iefc.org.br
